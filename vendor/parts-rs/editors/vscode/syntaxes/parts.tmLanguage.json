{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Parts",
  "scopeName": "source.pts",
  "fileTypes": ["pts"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#macros" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#delimiters" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.parts",
          "match": "//.*$"
        },
        {
          "name": "comment.block.parts",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.shebang.parts",
          "match": "^#!.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.std.parts",
          "match": "(@std/[a-zA-Z0-9_./-]+)"
        },
        {
          "name": "string.quoted.double.parts",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.parts",
              "match": "\\\\([nrt0bf\"\\\\]|x[0-9a-fA-F]{2})"
            },
            {
              "name": "invalid.illegal.escape.parts",
              "match": "\\\\[^nrt0bf\"\\\\]"
            }
          ]
        },
        {
          "name": "string.quoted.backtick.parts",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.parts",
              "match": "\\\\([nrt0bf\"\\\\]|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "meta.macro-def.parts",
          "match": "\\b(part)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.macro.parts" },
            "2": { "name": "entity.name.function.macro.parts" }
          }
        },
        {
          "name": "entity.name.function.macro-call.parts",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)!\\s*(?=[{(])"
        },
        {
          "name": "variable.parameter.macro.parts",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.parts",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.float.parts",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.parts",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.parts",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.parts",
          "match": "\\b[0-9]+([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.parts",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.repeat.parts",
          "match": "\\b(for|in)\\b"
        },
        {
          "name": "keyword.control.flow.parts",
          "match": "\\b(return|break|continue|raise)\\b"
        },
        {
          "name": "keyword.declaration.parts",
          "match": "\\b(let|fun|enum|import|syntax|translation|part)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.parts",
          "match": "\\b(Int|Double|Bool|String|Bytes|Result|Option)\\b"
        },
        {
          "name": "support.class.variant.parts",
          "match": "\\b(Ok|Err|Some|None)\\b"
        },
        {
          "name": "entity.name.type.enum.parts",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.parts",
          "match": "\\b(println|print|input|exec|env|len|join|to_uppercase|to_lowercase|to_hex|push|is_ok|is_err|is_some|is_none|unwrap|unwrap_or|unwrap_err|expect)\\b"
        },
        {
          "name": "support.module.std.parts",
          "match": "\\bstd(\\.[a-zA-Z_][a-zA-Z0-9_]*)*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function-decl.parts",
          "match": "\\blet\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.parts" }
          }
        },
        {
          "name": "meta.function-call.parts",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.parts" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.object.parts",
          "match": "\\|>|<\\|"
        },
        {
          "name": "keyword.operator.arrow.parts",
          "match": "=>"
        },
        {
          "name": "keyword.operator.namespace.parts",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.parts",
          "match": "==|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.shift.parts",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.parts",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.parts",
          "match": "&|\\||\\^|!"
        },
        {
          "name": "keyword.operator.assignment.parts",
          "match": "="
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.parts",
          "match": ","
        },
        {
          "name": "punctuation.separator.semicolon.parts",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.parts",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.parts",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.parts",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
