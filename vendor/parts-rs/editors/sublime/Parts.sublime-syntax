%YAML 1.2
---
name: Parts
file_extensions:
  - pts
scope: source.pts

contexts:
  main:
    - match: //.*$
      scope: comment.line.double-slash.parts
    - match: /\*
      scope: comment.block.parts
      push: block_comment
    - match: ^#!.*$
      scope: comment.line.shebang.parts

    # String literals
    - match: '(@std/[a-zA-Z0-9_./-]+)'
      scope: string.quoted.std.parts
    - match: '"'
      scope: punctuation.definition.string.begin.parts
      push: double_quoted_string
    - match: '`'
      scope: punctuation.definition.string.begin.parts
      push: backtick_string

    # Constants & Booleans
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.parts
    - match: '\b0[xX][0-9a-fA-F]+\b'
      scope: constant.numeric.hex.parts
    - match: '\b0[bB][01]+\b'
      scope: constant.numeric.binary.parts
    - match: '\b[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.float.parts
    - match: '\b[0-9]+([eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.integer.parts

    # Macro parameter variables
    - match: '@[a-zA-Z_][a-zA-Z0-9_]*'
      scope: variable.parameter.macro.parts
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)!\s*(?=[{(])'
      scope: entity.name.function.macro-call.parts

    # Keywords
    - match: '\b(if|else|match)\b'
      scope: keyword.control.conditional.parts
    - match: '\b(for|in)\b'
      scope: keyword.control.repeat.parts
    - match: '\b(return|break|continue|raise)\b'
      scope: keyword.control.flow.parts
    - match: '\b(let|fun|enum|import|syntax|translation|part)\b'
      scope: keyword.declaration.parts

    # Builtin types and variants
    - match: '\b(Int|Double|Bool|String|Bytes|Result|Option)\b'
      scope: support.type.builtin.parts
    - match: '\b(Ok|Err|Some|None)\b'
      scope: support.class.variant.parts
    - match: '\b[A-Z][a-zA-Z0-9_]*\b'
      scope: entity.name.type.enum.parts

    # Built-in functions
    - match: '\b(println|print|input|exec|env|len|join|to_uppercase|to_lowercase|to_hex|push|is_ok|is_err|is_some|is_none|unwrap|unwrap_or|unwrap_err|expect)\b'
      scope: support.function.builtin.parts

    # Function declarations
    - match: '\blet\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()'
      captures:
        1: entity.name.function.parts
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()'
      captures:
        1: entity.name.function.call.parts

    # Operators
    - match: '\|>|<\|'
      scope: keyword.operator.object.parts
    - match: '=>'
      scope: keyword.operator.arrow.parts
    - match: '::'
      scope: keyword.operator.namespace.parts
    - match: '==|<=|>=|<|>'
      scope: keyword.operator.comparison.parts
    - match: '<<|>>'
      scope: keyword.operator.shift.parts
    - match: '\+|-|\*|/|%'
      scope: keyword.operator.arithmetic.parts
    - match: '&|\||\^|!'
      scope: keyword.operator.bitwise.parts
    - match: '='
      scope: keyword.operator.assignment.parts

  block_comment:
    - match: \*/
      scope: comment.block.parts
      pop: true
    - match: .
      scope: comment.block.parts

  double_quoted_string:
    - match: '"'
      scope: punctuation.definition.string.end.parts
      pop: true
    - match: '\\([nrt0bf"\\]|x[0-9a-fA-F]{2})'
      scope: constant.character.escape.parts
    - match: '\\.'
      scope: invalid.illegal.escape.parts
    - match: '[^"\\\n]+'
      scope: string.quoted.double.parts

  backtick_string:
    - match: '`'
      scope: punctuation.definition.string.end.parts
      pop: true
    - match: '\\([nrt0bf"\\]|x[0-9a-fA-F]{2})'
      scope: constant.character.escape.parts
    - match: '[^`\\\n]+'
      scope: string.quoted.backtick.parts
