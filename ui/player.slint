import { TrackSelector, TrackInfo } from "./trackselector.slint";
import { SpeedSelector } from "./speedselector.slint";
import { AppIcon, Ic } from "./icons.slint";

// A round transport-bar button. Pass either `text` (a short label like
// "10s") or `icon` (an Ic.* path from icons.slint) - icon takes priority
// when both would otherwise apply.
export component RoundPlayerButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <color> bg: transparent;
    in property <color> hover-bg: #ffffff22;
    in property <color> active-bg: #ffffff44;
    in property <color> icon-color: white;
    in property <length> font-size: 16px;
    callback clicked();

    width: 40px;
    height: 40px;
    background: touch.pressed ? active-bg : (touch.has-hover ? hover-bg : bg);
    border-radius: 20px;
    border-width: 1px;
    border-color: bg != transparent ? transparent : #ffffff25;
    animate background { duration: 100ms; }

    if (root.icon != "") : AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        color: root.enabled ? root.icon-color : #555;
    }

    if (root.icon == "") : Text {
        text: root.text;
        color: root.enabled ? root.icon-color : #555;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component CustomSlider inherits Rectangle {
    in property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in property <bool> live_update: false;
    in property <bool> show_preview: false;
    in property <string> preview_label: "";
    out property <bool> dragging: false;
    private property <float> drag_value: 0.0;
    private property <float> shown_value: dragging ? drag_value : value;
    callback changed(float);
    callback hovered(float);
    callback dragging_changed(bool);

    height: 24px;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: touch.has-hover || root.dragging ? 7px : 4px;
        width: 100%;
        background: #ffffff44;
        border-radius: 4px;
        animate height { duration: 120ms; }

        Rectangle {
            width: parent.width * (root.shown_value - root.minimum) / (root.maximum - root.minimum);
            height: 100%;
            background: #9ce8e7;
            border-radius: 4px;
        }
    }

    Rectangle {
        x: (parent.width - self.width) * (root.shown_value - root.minimum) / (root.maximum - root.minimum);
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
        visible: touch.has-hover || root.dragging;
    }

    if (root.show_preview && (touch.has-hover || root.dragging) && root.preview_label != "") : Rectangle {
        x: Math.max(0px, Math.min(parent.width - self.width, touch.mouse-x - self.width / 2));
        y: -30px;
        width: 68px;
        height: 26px;
        border-radius: 5px;
        background: #18272eea;
        border-width: 1px;
        border-color: #ffffff33;
        Text {
            text: root.preview_label;
            color: white;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        pointer-event(evt) => {
            let new-val = root.minimum + (self.mouse-x / parent.width) * (root.maximum - root.minimum);
            let clamped = Math.max(root.minimum, Math.min(root.maximum, new-val));
            if (evt.kind == PointerEventKind.down) {
                root.dragging = true;
                root.dragging_changed(true);
                root.drag_value = clamped;
            } else if (evt.kind == PointerEventKind.move && root.dragging) {
                root.drag_value = clamped;
                if (root.live_update) { root.changed(clamped); }
            } else if (evt.kind == PointerEventKind.up && root.dragging) {
                root.drag_value = clamped;
                root.changed(clamped);
                root.dragging = false;
                root.dragging_changed(false);
            } else if (evt.kind == PointerEventKind.cancel) {
                root.dragging = false;
                root.dragging_changed(false);
            }
            if (root.show_preview && (self.has-hover || root.dragging)) {
                root.hovered(clamped);
            }
        }
    }
}

export component Player inherits Rectangle {
	callback toggle_pause();
    callback skip_by(int);
    callback seek(float);
    callback seek_hover(float);
    callback user_activity();
    callback select_audio_track(int);
    callback select_subtitle_track(int);
    callback change_speed(float);
    callback open_file();
    // Toggles the spincard info card mpv draws into the video frame;
    // `lean` picks the trimmed variant (see script-opts/spincard.conf).
    callback toggle_info_card(bool);
    // GPU decode toggle; reports the decoder mpv actually picked on the OSD.
    callback toggle_hwdec();
    callback set_volume(float);
    callback toggle_mute();
    callback toggle_fullscreen();

    callback next();
    callback previous();

    width: 100%;
    height: 100%;
    background: black;

    // Grabs keyboard focus as soon as the player exists so shortcuts work
    // without an extra click first; doesn't intercept pointer events since
    // FocusScope has no visual/hit-testing footprint of its own.
    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        init => { key-handler.focus(); }
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle_pause();
                accept
            } else if (event.text == Key.LeftArrow) {
                root.skip_by(-10);
                accept
            } else if (event.text == Key.RightArrow) {
                root.skip_by(30);
                accept
            } else if (event.text == "n") {
                root.next();
                accept
            } else if (event.text == "p") {
                root.previous();
                accept
            } else if (event.text == "o" && event.modifiers.control) {
                root.open_file();
                accept
            } else if (event.text == "c") {
                root.toggle_info_card(false);
                accept
            } else if (event.text == "C") {
                root.toggle_info_card(true);
                accept
            } else if (event.text == "m" || event.text == "M") {
                root.toggle_mute();
                accept
            } else if (event.text == Key.UpArrow) {
                root.set_volume(Math.min(100, root.volume + 5));
                accept
            } else if (event.text == Key.DownArrow) {
                root.set_volume(Math.max(0, root.volume - 5));
                accept
            } else if (event.text == Key.F11 || event.text == "f") {
                root.toggle_fullscreen();
                accept
            } else if (event.text == Key.Escape && root.is_fullscreen) {
                root.toggle_fullscreen();
                accept
            } else {
                reject
            }
        }
    }

    // Player Properties
    in property <image> video_frame;
    in property <bool> is_paused: false;
    in property <float> progress: 0.0;
    in property <float> duration_seconds: 0.0;
    in property <string> seek_preview: "";
    in property <float> volume: 100.0;
    in property <bool> is_muted: false;
    in property <bool> is_fullscreen: false;
    in property <string> time_pos: "00:00";
    in property <string> duration: "00:00";
    in property <bool> controls_visible: true;
    in property <string> playback_speed: "1.00x";

    in property <bool> has_next;
    in property <bool> has_previous;
    out property <bool> is_scrubbing: false;

    in property <[TrackInfo]> audio_tracks: [];
    in property <[TrackInfo]> subtitle_tracks: [];
    in property <string> audio_track_name: "Default";
    in property <string> subtitle_track_name: "None";

    in property <string> video_title: "";
    in property <string> remaining_time: "-00:00";
    in property <string> ends_at: "";

    Image {
        source: root.video_frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    TouchArea {
        // Keep visibility on click
        clicked => { root.user_activity(); }
        // Move activity
        pointer-event(evt) => { root.user_activity(); }
    }

    // Nothing loaded yet: a background image and a centered prompt instead
    // of idle playback controls.
    if root.video_title == "" : Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        Image {
            source: @image-url("../images/CedarApple.png");
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Darken the background so the prompt stays readable over it.
        Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a0;
        }

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                AppIcon { data: Ic.play; size: 48px; color: #9ce8e7; }
            }

            HorizontalLayout {
                alignment: center;
                Text { text: "Your next watch starts here"; color: white; font-size: 25px; font-weight: 700; }
            }

            HorizontalLayout {
                alignment: center;
                Text { text: "Play a video from your computer"; color: #ffffffaa; font-size: 14px; }
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 172px;
                    height: 44px;
                    background: open-touch.has-hover ? #c4f6f1 : #9ce8e7;
                    border-radius: 8px;
                    animate background { duration: 120ms; }
                    Text {
                        text: "Open video";
                        color: #10282b;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    open-touch := TouchArea { clicked => root.open_file(); }
                }
            }

            HorizontalLayout {
                alignment: center;
                Text { text: "Ctrl+O"; color: #ffffff77; font-size: 12px; }
            }
        }
    }

    // Top Bar Overlay
    if root.controls_visible || root.video_title == "" : Rectangle {
        background: @linear-gradient(180deg, #000000aa 0%, #00000000 100%);
        height: 100px;
        width: 100%;
        x: 0;
        y: 0;

        HorizontalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-top: 20px;
            alignment: space-between;

            Text {
                width: root.width - 110px;
                text: root.video_title == "" ? "CedarApple" : root.video_title;
                color: white;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            // Open a different file (Ctrl+O also works)
            RoundPlayerButton {
                icon: Ic.folder-open;
                clicked => { root.open_file(); }
            }
        }
    }

    // Playback chrome is implemented in Slint, with the most useful
    // information from Frame Player's control surface.
    if root.controls_visible && root.video_title != "" : Rectangle {
        background: @linear-gradient(0deg, #070d13f5 0%, #070d13dd 55%, #070d1300 100%);
        height: 235px;
        width: 100%;
        y: parent.height - self.height;

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 18px;
            spacing: 5px;
            alignment: end;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.ends_at;
                    color: #c9d3d9;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 8px;
                    TrackSelector {
                        label: "Audio";
                        tracks: root.audio_tracks;
                        current_name: root.audio_track_name;
                        select_track(id) => root.select_audio_track(id);
                    }
                    TrackSelector {
                        label: "Subtitles";
                        tracks: root.subtitle_tracks;
                        current_name: root.subtitle_track_name;
                        select_track(id) => root.select_subtitle_track(id);
                    }
                    RoundPlayerButton {
                        text: "i";
                        font-size: 18px;
                        clicked => root.toggle_info_card(false);
                    }
                    RoundPlayerButton {
                        text: "GPU";
                        font-size: 11px;
                        clicked => root.toggle_hwdec();
                    }
                }
            }

            timeline := CustomSlider {
                value: root.progress;
                minimum: 0;
                maximum: 100;
                show_preview: root.duration_seconds > 0;
                preview_label: root.seek_preview;
                hovered(val) => {
                    root.user_activity();
                    root.seek_hover(val);
                }
                changed(val) => {
                    root.user_activity();
                    root.seek(val);
                }
                dragging_changed(active) => { root.is_scrubbing = active; }
            }

            HorizontalLayout {
                alignment: space-between;
                Text { text: root.time_pos; color: #dfe8ed; font-size: 12px; }
                Text { text: root.duration; color: #dfe8ed; font-size: 12px; }
            }

            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 7px;
                    RoundPlayerButton {
                        icon: root.is_muted || root.volume <= 0 ? Ic.volume-off : Ic.volume-on;
                        clicked => root.toggle_mute();
                    }
                    CustomSlider {
                        width: 95px;
                        value: root.volume;
                        minimum: 0;
                        maximum: 100;
                        live_update: true;
                        changed(val) => {
                            root.user_activity();
                            root.set_volume(val);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    if (root.has_previous || root.has_next) : RoundPlayerButton {
                        icon: Ic.prev;
                        enabled: root.has_previous;
                        clicked => root.previous();
                    }
                    RoundPlayerButton {
                        text: "-10";
                        font-size: 13px;
                        clicked => root.skip_by(-10);
                    }
                    Rectangle {
                        width: 56px;
                        height: 44px;
                        background: play-touch.has-hover ? #c4f6f1 : #9ce8e7;
                        border-radius: 10px;
                        animate background { duration: 120ms; }
                        AppIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            data: root.is_paused ? Ic.play : Ic.pause;
                            color: #10282b;
                            size: 23px;
                        }
                        play-touch := TouchArea { clicked => root.toggle_pause(); }
                    }
                    RoundPlayerButton {
                        text: "+30";
                        font-size: 13px;
                        clicked => root.skip_by(30);
                    }
                    if (root.has_previous || root.has_next) : RoundPlayerButton {
                        icon: Ic.next;
                        enabled: root.has_next;
                        clicked => root.next();
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    SpeedSelector {
                        label: "Speed";
                        current_speed_name: root.playback_speed;
                        select_speed(speed) => root.change_speed(speed);
                    }
                    RoundPlayerButton {
                        icon: root.is_fullscreen ? Ic.fullscreen-exit : Ic.fullscreen;
                        clicked => root.toggle_fullscreen();
                    }
                }
            }
        }
    }
}
