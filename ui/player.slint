import { Button, HorizontalBox, VerticalBox, Slider, ScrollView, LineEdit } from "std-widgets.slint";

import { TrackSelector, TrackInfo } from "./trackselector.slint";
import { SpeedSelector } from "./speedselector.slint";
import { AppIcon, Ic } from "./icons.slint";

// A round transport-bar button. Pass either `text` (a short label like
// "10s") or `icon` (an Ic.* path from icons.slint) - icon takes priority
// when both would otherwise apply.
export component RoundPlayerButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <color> bg: transparent;
    in property <color> hover-bg: #ffffff22;
    in property <color> active-bg: #ffffff44;
    in property <color> icon-color: white;
    in property <length> font-size: 16px;
    callback clicked();

    width: 40px;
    height: 40px;
    background: touch.pressed ? active-bg : (touch.has-hover ? hover-bg : bg);
    border-radius: 20px;
    border-width: 1px;
    border-color: bg != transparent ? transparent : #ffffff25;
    animate background { duration: 100ms; }

    if (root.icon != "") : AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        color: root.enabled ? root.icon-color : #555;
    }

    if (root.icon == "") : Text {
        text: root.text;
        color: root.enabled ? root.icon-color : #555;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component CustomSlider inherits Rectangle {
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    callback changed(float);

    height: touch.has-hover || touch.pressed ? 8px : 4px;
    background: #333;
    border-radius: 4px;
    animate height { duration: 150ms; }

    // Active progress track
    Rectangle {
        x: 0;
        width: parent.width * (root.value - root.minimum) / (root.maximum - root.minimum);
        height: 100%;
        background: #00d0f0; // Beautiful cyan
        border-radius: 4px;
    }

    // Handle
    handle := Rectangle {
        x: (parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum);
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        border-width: 1px;
        border-color: #00d0f0;
        visible: touch.has-hover || touch.pressed;
    }

    touch := TouchArea {
        pointer-event(evt) => {
            if (self.pressed) {
                let new-val = root.minimum + (self.mouse-x / parent.width) * (root.maximum - root.minimum);
                root.value = Math.max(root.minimum, Math.min(root.maximum, new-val));
                root.changed(root.value);
            }
        }
        clicked => {
            let new-val = root.minimum + (self.mouse-x / parent.width) * (root.maximum - root.minimum);
            root.value = Math.max(root.minimum, Math.min(root.maximum, new-val));
            root.changed(root.value);
        }
    }
}

export component Player inherits Rectangle {
	callback toggle_pause();
    callback skip_by(int);
    callback seek(float);
    callback user_activity();
    callback select_audio_track(int);
    callback select_subtitle_track(int);
    callback change_speed(float);
    callback open_file();
    // Toggles the spincard info card mpv draws into the video frame;
    // `lean` picks the trimmed variant (see script-opts/spincard.conf).
    callback toggle_info_card(bool);
    // GPU decode toggle; reports the decoder mpv actually picked on the OSD.
    callback toggle_hwdec();

    callback next();
    callback previous();

    width: 100%;
    height: 100%;
    background: black;

    // Grabs keyboard focus as soon as the player exists so shortcuts work
    // without an extra click first; doesn't intercept pointer events since
    // FocusScope has no visual/hit-testing footprint of its own.
    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        init => { key-handler.focus(); }
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle_pause();
                accept
            } else if (event.text == Key.LeftArrow) {
                root.skip_by(-10);
                accept
            } else if (event.text == Key.RightArrow) {
                root.skip_by(30);
                accept
            } else if (event.text == "n") {
                root.next();
                accept
            } else if (event.text == "p") {
                root.previous();
                accept
            } else if (event.text == "o" && event.modifiers.control) {
                root.open_file();
                accept
            } else if (event.text == "c") {
                root.toggle_info_card(false);
                accept
            } else if (event.text == "C") {
                root.toggle_info_card(true);
                accept
            } else {
                reject
            }
        }
    }

    // Player Properties
    in property <image> video_frame;
    in property <bool> is_paused: false;
    in property <float> progress: 0.0;
    in property <string> time_pos: "00:00";
    in property <string> duration: "00:00";
    in property <bool> controls_visible: true;
    in property <string> playback_speed: "1.00x";

    in property <bool> has_next;
    in property <bool> has_previous;

    in property <[TrackInfo]> audio_tracks: [];
    in property <[TrackInfo]> subtitle_tracks: [];
    in property <string> audio_track_name: "Default";
    in property <string> subtitle_track_name: "None";

    in property <string> video_title: "";
    in property <string> remaining_time: "-00:00";
    in property <string> ends_at: "";

    Image {
        source: root.video_frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    TouchArea {
        // Keep visibility on click
        clicked => { root.user_activity(); }
        // Move activity
        pointer-event(evt) => { root.user_activity(); }
    }

    // Nothing loaded yet: a background image and a centered prompt instead
    // of idle playback controls.
    if root.video_title == "" : Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        Image {
            source: @image-url("../images/CedarApple.png");
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Darken the background so the prompt stays readable over it.
        Rectangle {
            width: 100%;
            height: 100%;
            background: #000000a0;
        }

        // Adapted from vayou-slint's own "no file loaded" invitation
        // (ui/app.slint) - each row is its own centered HorizontalLayout
        // rather than relying on VerticalLayout to center fixed-size
        // children on the cross axis, which it doesn't do on its own.
        // The only click target stays the top bar's Open button, so there's
        // one Open affordance on screen, not two.
        VerticalLayout {
            alignment: center;
            spacing: 6px;

            HorizontalLayout {
                alignment: center;
                AppIcon { data: Ic.folder-open; size: 56px; color: #ffffff66; }
            }

            HorizontalLayout {
                alignment: center;
                Text { text: "CedarApple"; color: #ffffff88; font-size: 14px; }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                Text { text: "Press"; color: #ffffff55; font-size: 12px; vertical-alignment: center; }

                Rectangle {
                    background: #ffffff1a;
                    border-radius: 4px;
                    width: shortcut-chip.preferred-width;
                    height: shortcut-chip.preferred-height;

                    shortcut-chip := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text { text: "Ctrl+O"; color: #ffffffcc; font-size: 12px; }
                    }
                }

                Text { text: "or click Open to load a video"; color: #ffffff55; font-size: 12px; vertical-alignment: center; }
            }
        }
    }

    // Top Bar Overlay
    if root.controls_visible || root.video_title == "" : Rectangle {
        background: @linear-gradient(180deg, #000000aa 0%, #00000000 100%);
        height: 100px;
        width: 100%;
        x: 0;
        y: 0;

        HorizontalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-top: 20px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 15px;
                alignment: start;

                Text {
                    text: root.video_title;
                    color: white;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            // Open a different file (Ctrl+O also works)
            RoundPlayerButton {
                icon: Ic.folder-open;
                clicked => { root.open_file(); }
            }
        }
    }

    // Bottom Bar Overlay
    if root.controls_visible && root.video_title != "" : Rectangle {
        background: @linear-gradient(0deg, #000000cc 0%, #000000aa 50%, #00000000 100%);
        height: 200px;
        width: 100%;
        x: 0;
        y: parent.height - self.height;

        VerticalLayout {
            padding-left: 30px;
            padding-right: 30px;
            padding-bottom: 25px;
            spacing: 12px;
            alignment: end;

            // Row 1: Ends at (left) and Badges (right)
            HorizontalLayout {
                alignment: space-between;
                
                Text {
                    text: root.ends_at;
                    color: #ccc;
                    font-size: 13px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    
                    // Direct badge
                    Rectangle {
                        background: #ffffff15;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ffffff25;
                        
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            Text {
                                text: "Direct";
                                color: white;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }
                    }

                    // SDR HD badge
                    Rectangle {
                        background: #ffffff15;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ffffff25;
                        
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            Text {
                                text: "SDR HD";
                                color: white;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }

            // Row 2: Progress Slider
            CustomSlider {
                value: root.progress;
                minimum: 0;
                maximum: 100;
                changed(val) => { root.seek(val); }
            }

            // Row 3: Current Time and Remaining Time
            HorizontalLayout {
                alignment: space-between;
                
                Text {
                    text: root.time_pos;
                    color: #aaa;
                    font-size: 12px;
                }

                Text {
                    text: root.remaining_time;
                    color: #aaa;
                    font-size: 12px;
                }
            }

            // Row 4: Controls Row
            HorizontalLayout {
                alignment: space-between;

                // Left: Option Buttons (Audio / Subtitles)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    TrackSelector {
                        label: "Audio:";
                        tracks: root.audio_tracks;
                        current_name: root.audio_track_name;
                        select_track(id) => { root.select_audio_track(id); }
                    }

                    TrackSelector {
                        label: "Subtitles:";
                        tracks: root.subtitle_tracks;
                        current_name: root.subtitle_track_name;
                        select_track(id) => { root.select_subtitle_track(id); }
                    }
                }

                // Center: Playback Buttons
                HorizontalLayout {
                    spacing: 15px;
                    alignment: center;

                    // Previous / Rewind
                    RoundPlayerButton {
                        icon: Ic.prev;
                        enabled: root.has_previous;
                        clicked => { root.previous(); }
                    }

                    // Skip Back 10s
                    RoundPlayerButton {
                        text: "⟲ 10s";
                        font-size: 14px;
                        clicked => { root.skip_by(-10); }
                    }

                    // Play/Pause Button
                    Rectangle {
                        width: 60px;
                        height: 45px;
                        background: play-touch.pressed ? #2d4d50 : (play-touch.has-hover ? #3d6366 : #355659);
                        border-radius: 12px;
                        animate background { duration: 100ms; }

                        AppIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            data: root.is_paused ? Ic.play : Ic.pause;
                            size: 20px;
                        }

                        play-touch := TouchArea {
                            clicked => { root.toggle_pause(); }
                        }
                    }

                    // Skip Forward 30s
                    RoundPlayerButton {
                        text: "30s ⟳";
                        font-size: 14px;
                        clicked => { root.skip_by(30); }
                    }

                    // Next / Fast Forward
                    RoundPlayerButton {
                        icon: Ic.next;
                        enabled: root.has_next;
                        clicked => { root.next(); }
                    }
                }

                // Right: Info card + Speed Selector
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    // Info card (spincard) - also on "c", lean card on "C".
                    RoundPlayerButton {
                        text: "i";
                        font-size: 18px;
                        clicked => { root.toggle_info_card(false); }
                    }

                    // Hardware decoding on/off; the result shows on mpv's OSD.
                    RoundPlayerButton {
                        text: "GPU";
                        font-size: 11px;
                        clicked => { root.toggle_hwdec(); }
                    }

                    SpeedSelector {
                        label: "Speed:";
                        current_speed_name: root.playback_speed;
                        select_speed(speed) => { root.change_speed(speed); }
                    }
                }
            }
        }
    }
}
