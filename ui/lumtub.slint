// Lumtub's YouTube browsing, drawn in CedarApple's native Slint UI.
import { Theme } from "./theme.slint";
import { DialogButton } from "./dialogs.slint";
import { Field, Dropdown } from "./widgets.slint";
import { ScrollView, Spinner } from "std-widgets.slint";

export struct LumtubRow {
    title: string,
    detail: string,
    description: string,
    kind: string,
    cover: image,
    has-cover: bool,
    saved: bool,
    has-channel: bool,
}

export global LumtubState {
    in-out property <bool> open;
    in-out property <bool> busy;
    in-out property <bool> resolving;
    in-out property <string> query;
    in-out property <string> filter: "All";
    in-out property <string> category: "Science & technology";
    in-out property <string> location: "Explore";
    in-out property <string> section: "Explore";
    in-out property <string> channel-tab: "Videos";
    in-out property <bool> is-channel;
    in-out property <bool> followed;
    in-out property <bool> can-back;
    in-out property <bool> has-more;
    in-out property <int> generation;
    in-out property <[LumtubRow]> rows;
    in-out property <string> error;
    in-out property <string> status;
    callback opened();
    callback closed();
    callback search();
    callback browse(string);
    callback category-picked(string);
    callback filter-picked(string);
    callback tab-picked(string);
    callback item-picked(int);
    callback save-item(int);
    callback channel(int);
    callback follow();
    callback back();
    callback more();
    callback retry();
    callback cancel();
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.active ? Theme.accent-strong : touch.has-hover ? Theme.hover : #ffffff08;
    Text {
        text: root.text;
        color: root.active ? white : Theme.text-soft;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component LumtubDialog inherits Rectangle {
    public function focus-input() { search-box.focus-input(); }
    background: #000000a6;
    TouchArea { clicked => { LumtubState.closed(); } }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { LumtubState.closed(); return accept; }
            return reject;
        }
        panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 16px;
            width: Math.min(1080px, parent.width - 32px);
            height: parent.height - 32px;
            background: Theme.dialog-bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: #ffffff24;
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Lumtub"; color: Theme.text; font-size: 22px; font-weight: 600; vertical-alignment: center; }
                    if panel.width > 640px : Text { text: "YouTube in CedarApple"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    DialogButton { text: "Close"; clicked => { LumtubState.closed(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    NavButton { text: "Explore"; active: LumtubState.section == "Explore"; clicked => { LumtubState.browse("Explore"); } }
                    NavButton { text: "Watch later"; active: LumtubState.section == "Watch later"; clicked => { LumtubState.browse("Watch later"); } }
                    NavButton { text: "History"; active: LumtubState.section == "History"; clicked => { LumtubState.browse("History"); } }
                    NavButton { text: "Channels"; active: LumtubState.section == "Channels"; clicked => { LumtubState.browse("Channels"); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    search-box := Field {
                        horizontal-stretch: 1;
                        text <=> LumtubState.query;
                        placeholder: "Search YouTube or paste a video / playlist link";
                        accepted => { LumtubState.search(); }
                    }
                    if panel.width > 600px : Dropdown {
                        width: 130px;
                        options: ["All", "Videos", "Shorts", "Live", "Channels", "Playlists"];
                        value: LumtubState.filter;
                        picked(value) => { LumtubState.filter-picked(value); }
                    }
                    DialogButton { text: "Search"; primary: true; clicked => { LumtubState.search(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    DialogButton { text: "Back"; enabled: LumtubState.can-back; clicked => { LumtubState.back(); } }
                    Text { text: LumtubState.location; color: Theme.text-dim; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    if LumtubState.section == "Explore" && !LumtubState.is-channel && panel.width > 600px : Dropdown {
                        width: 200px;
                        options: ["Science & technology", "Music", "Gaming", "Film & animation", "Education", "Travel & nature", "Sports"];
                        value: LumtubState.category;
                        picked(value) => { LumtubState.category-picked(value); }
                    }
                    if LumtubState.is-channel : Dropdown {
                        width: 110px;
                        options: ["Videos", "Shorts", "Live", "Playlists"];
                        value: LumtubState.channel-tab;
                        picked(value) => { LumtubState.tab-picked(value); }
                    }
                    if LumtubState.is-channel : DialogButton {
                        text: LumtubState.followed ? "Following" : "Follow";
                        clicked => { LumtubState.follow(); }
                    }
                }
                if LumtubState.error != "" : HorizontalLayout {
                    spacing: 8px;
                    Text { text: LumtubState.error; color: Theme.error; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    DialogButton { text: "Retry"; clicked => { LumtubState.retry(); } }
                }
                results := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: list.preferred-height;
                    property <int> generation: LumtubState.generation;
                    changed generation => { self.viewport-y = 0; }
                    list := VerticalLayout {
                        width: results.visible-width - 12px;
                        spacing: 8px;
                        alignment: start;
                        for row[index] in LumtubState.rows : Rectangle {
                            height: 110px;
                            border-radius: 10px;
                            background: touch.has-hover ? Theme.menu-hover : #ffffff08;
                            touch := TouchArea {
                                mouse-cursor: LumtubState.resolving ? default : pointer;
                                enabled: !LumtubState.resolving;
                                clicked => { LumtubState.item-picked(index); }
                            }
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 12px;
                                if panel.width > 620px : Rectangle {
                                    width: 164px;
                                    border-radius: 6px;
                                    background: #00000055;
                                    clip: true;
                                    if row.has-cover : Image { source: row.cover; image-fit: contain; }
                                    if !row.has-cover : Text { text: row.kind == "video" ? "▶" : row.kind == "channel" ? "Channel" : "Playlist"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: row.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: row.detail; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                                    if row.description != "" : Text { text: row.description; color: Theme.muted; font-size: 11px; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    if row.kind == "video" : DialogButton { text: row.saved ? "Saved ✓" : "Save"; clicked => { LumtubState.save-item(index); } }
                                    if row.has-channel && panel.width > 760px : DialogButton { text: "Channel"; clicked => { LumtubState.channel(index); } }
                                    if row.kind == "channel" : DialogButton { text: row.saved ? "Following" : "Follow"; clicked => { LumtubState.save-item(index); } }
                                }
                            }
                        }
                        if !LumtubState.busy && LumtubState.rows.length == 0 && LumtubState.error == "" : Rectangle {
                            height: 130px;
                            Text { text: LumtubState.section == "Watch later" ? "Save videos to watch them later." : LumtubState.section == "History" ? "Videos you play will appear here." : LumtubState.section == "Channels" ? "Find a channel and follow it to keep it here." : "No results. Try a different search."; color: Theme.text-dim; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                        }
                        if LumtubState.has-more && !LumtubState.busy : HorizontalLayout {
                            alignment: center;
                            DialogButton { text: "Load more"; clicked => { LumtubState.more(); } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    if LumtubState.busy || LumtubState.resolving : Spinner { indeterminate: true; width: 18px; height: 18px; }
                    Text { text: LumtubState.status; color: Theme.muted; font-size: 11.5px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    if LumtubState.busy || LumtubState.resolving : DialogButton { text: "Cancel"; clicked => { LumtubState.cancel(); } }
                }
            }
        }
    }
}
