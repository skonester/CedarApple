// Data the Rust side hands the UI. Kept in one file so app-window.slint can
// re-export all of them and Rust gets a generated struct for each.

export struct TrackInfo {
    id: int,
    name: string,
    active: bool,
}

export struct ChapterInfo {
    title: string,
    // Seconds from the start of the file.
    time: float,
}

// One entry of the play queue (mpv's playlist).
export struct QueueEntry {
    name: string,
    current: bool,
}

// A stretch of a torrent file already on disk, as fractions of the file.
export struct Band {
    from: float,
    to: float,
}

// A row of the start screen's torrent list.
export struct TorrentRowData {
    folder: string,
    name: string,
    meta: string,
    resume: string,
    // A magnet is known, so the row can be reopened.
    openable: bool,
    // This torrent is what mpv is streaming right now: it cannot be deleted.
    playing: bool,
    watched: int,
}

// A row of the Settings dialog (src/settings.rs builds them). `kind`: header,
// toggle, choice, seg, slider, text, path or action; `options` are a choice's
// or segment's values, a text box's placeholder; `num`/`min`/`max`/`step` and
// `display` are a slider's.
export struct SettingRow {
    id: string,
    kind: string,
    title: string,
    info: string,
    value: string,
    display: string,
    options: [string],
    num: float,
    min: float,
    max: float,
    step: float,
}

// A Free Music result row (src/free_music): cover, title, artist · album,
// source badge, licence chip (green when commercial use is allowed), length.
export struct FmRow {
    title: string,
    sub: string,
    badge: string,
    lic: string,
    free: bool,
    dur: string,
    cover: image,
    has-cover: bool,
    // The source allows a download.
    dl: bool,
    // Downloaded already.
    saved: bool,
    selected: bool,
}

// A Free Music filter dropdown: mood, licence, length, sort.
export struct FmFilter {
    name: string,
    options: [string],
    value: string,
}

// A video of a torrent, in the "What to watch" list.
export struct PickFile {
    index: int,
    name: string,
    path: string,
    size: string,
    left: string,
    started: bool,
    done: bool,
}
