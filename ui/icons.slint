// The player's glyphs, taken from Frame Player's components (Controls.svelte,
// StartScreen.svelte, TopBar.svelte, TorrentPickDialog.svelte), GPL-3.0-or-later,
// Copyright (c) Evgenii Zakharov. The filled ones are Material paths on a 24-unit
// box; the outlined ones are Frame Player's own strokes on a 16- or 10-unit box.
// See the comments in Controls.svelte for why the queue and chapter glyphs sit
// on a 1.2-unit grid.

// A filled glyph.
export component AppIcon {
    in property <string> data;
    in property <brush> color: white;
    in property <length> size: 20px;
    in property <float> viewbox: 24;

    width: size;
    height: size;
    Path {
        commands: root.data;
        fill: root.color;
        viewbox-width: root.viewbox;
        viewbox-height: root.viewbox;
        width: 100%;
        height: 100%;
    }
}

// An outlined glyph.
export component StrokeIcon {
    in property <string> data;
    in property <brush> color: white;
    in property <length> size: 14px;
    in property <float> viewbox: 16;
    in property <length> stroke-width: 1.5px;

    width: size;
    height: size;
    Path {
        commands: root.data;
        fill: transparent;
        stroke: root.color;
        stroke-width: root.stroke-width;
        viewbox-width: root.viewbox;
        viewbox-height: root.viewbox;
        width: 100%;
        height: 100%;
    }
}

